{
  "name": "stepfun-kb",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "端侧向量化 + seekdb 混合检索的迷你知识库",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
