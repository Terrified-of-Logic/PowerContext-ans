# Replace YOUR_PUBLIC_IP after obtaining a matching IP certificate.
# This is a separate server block; preserve existing port-80 sites.
server {
    listen 443 ssl;
    server_name YOUR_PUBLIC_IP;
    ssl_certificate /etc/midnight-letsencrypt/live/midnight-memory/fullchain.pem;
    ssl_certificate_key /etc/midnight-letsencrypt/live/midnight-memory/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;

    # Optional: publish only the credential-free submission DSL for URL import.
    location = /midnight/dsl.yml {
        alias /var/www/midnight-assets/midnight-ai.yml;
        default_type application/yaml;
        add_header Cache-Control "no-store";
    }

    location /midnight/ {
        proxy_pass http://127.0.0.1:8765/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    location / { return 404; }
}
